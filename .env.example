# Copy to .env and adjust. Docker Compose reads .env automatically.

# Port the app is published on (http://localhost:8080)
APP_PORT=8080

# PostgreSQL credentials and the host port the database is published on
DB_USERNAME=tasklane
DB_PASSWORD=change-me
DB_PORT=5432

# Seed a demo account (demo@example.com / demo1234) and sample boards on first start
DEMO_DATA=true

# Allow anyone to create an account from the sign-up page
REGISTRATION_ENABLED=true

# Set to true when serving over HTTPS so the session cookie is only sent securely
SESSION_COOKIE_SECURE=false
